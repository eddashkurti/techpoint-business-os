server {
    listen 8080;
    server_name ${ERP_HOST};
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://${ERP_HOST}$request_uri; }
}
server {
    listen 8443 ssl;
    http2 on;
    server_name ${ERP_HOST};
    server_tokens off;
    root /var/www/html/public;
    index index.php;
    ssl_certificate /certificates/live/${ERP_HOST}/fullchain.pem;
    ssl_certificate_key /certificates/live/${ERP_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 16m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Logs intentionally omit query strings, which may contain download tokens.
    access_log /var/log/nginx/access.log techpoint;
    if (-f /var/www/storage/framework/down) { return 503; }
    error_page 503 =503 @maintenance;
    location @maintenance {
        default_type text/plain;
        add_header Retry-After 60 always;
        return 503 "TechPoint po kryen mirembajtje. Ju lutemi provoni perseri pas pak.\n";
    }
    location / { try_files $uri $uri/ /index.php?$query_string; }
    location = /index.php {
        internal;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass app:9000;
        fastcgi_read_timeout 65s;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
    location ^~ /storage/ { return 404; }
}
