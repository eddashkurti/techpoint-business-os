# Install as /etc/techpoint/backup.env, owned by root, mode 600.
TECHPOINT_ROOT=/opt/techpoint-business-os
COMPOSE_ENV_FILE=/etc/techpoint/production.env
SECRETS_DIRECTORY=/etc/techpoint/secrets
# Supply the actual approved provider endpoint and private bucket; this is a placeholder.
RESTIC_REPOSITORY=s3:https://YOUR_APPROVED_S3_ENDPOINT/YOUR_PRIVATE_BUCKET/techpoint
RESTIC_PASSWORD_FILE=/etc/techpoint/secrets/restic_password
AWS_ACCESS_KEY_ID_FILE=/etc/techpoint/secrets/backup_access_key_id
AWS_SECRET_ACCESS_KEY_FILE=/etc/techpoint/secrets/backup_secret_access_key
BACKUP_HOST_ID=techpoint-production
BACKUP_TAG=techpoint
BACKUP_STAGING_DIRECTORY=/var/lib/techpoint/backup-staging
BACKUP_STATUS_DIRECTORY=/var/lib/techpoint/backup-status
RESTIC_CACHE_DIR=/var/cache/techpoint-restic
