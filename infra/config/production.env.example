COMPOSE_PROJECT_NAME=techpoint
APP_URL=https://erp.example.invalid
ERP_HOST=erp.example.invalid
APP_IMAGE=techpoint-business-os
WEB_IMAGE=techpoint-web
APP_IMAGE_TAG=replace-with-reviewed-git-commit
DB_DATABASE=techpoint
DB_USERNAME=techpoint
# Absolute host paths keep resolution clear when invoked by systemd.
SECRETS_DIRECTORY=/etc/techpoint/secrets
TLS_DIRECTORY=/etc/letsencrypt
ACME_DIRECTORY=/var/lib/techpoint/acme
# Mail configuration must be completed for recovery/notification emails.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=system@example.invalid
